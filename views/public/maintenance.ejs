<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="<%= themeColor %>">
  <title><%= title %> · <%= siteName %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --smoky-black: hsl(0, 0%, 7%);
      --eerie-black-2: hsl(240, 2%, 12%);
      --jet: hsl(0, 0%, 22%);
      --white-1: hsl(0, 0%, 100%);
      --light-gray: hsl(0, 0%, 84%);
      --light-gray-70: hsla(0, 0%, 84%, 0.7);
      --orange-yellow-crayola: hsl(45, 100%, 72%);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Poppins', sans-serif;
      background: radial-gradient(ellipse at top, hsla(45, 100%, 72%, 0.06), transparent 55%), var(--smoky-black);
      color: var(--light-gray);
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      text-align: center;
    }
    .card {
      max-width: 460px;
      background: var(--eerie-black-2);
      border: 1px solid var(--jet);
      border-radius: 18px;
      padding: 40px 32px;
    }
    .icon {
      width: 62px; height: 62px;
      margin: 0 auto 22px;
      border-radius: 16px;
      display: grid; place-items: center;
      background: linear-gradient(to right, hsl(45, 100%, 72%), hsl(35, 100%, 68%));
      color: var(--smoky-black);
      font-size: 30px;
    }
    h1 { color: var(--white-1); font-size: 22px; font-weight: 500; margin-bottom: 12px; }
    p { font-size: 15px; line-height: 1.7; color: var(--light-gray-70); }
    .site { margin-top: 26px; font-size: 12px; color: var(--light-gray-70); }
    .site strong { color: var(--orange-yellow-crayola); font-weight: 500; }
    @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
  </style>
</head>
<body>
  <main class="card">
    <div class="icon" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
    </div>

    <h1><%= title %></h1>
    <p><%= message %></p>

    <p class="site"><strong><%= siteName %></strong></p>
  </main>
</body>
</html>
