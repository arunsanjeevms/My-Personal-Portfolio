<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= csrfToken() %>">
  <title>Change password · Portfolio CMS</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/admin/css/admin.css">
  <link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml">
</head>
<body>

<main class="auth-page">
  <div class="auth-card">

    <div class="auth-brand">
      <span class="brand-mark" aria-hidden="true"><ion-icon name="key-outline"></ion-icon></span>
      <h1 class="auth-title">Change password</h1>
      <p class="auth-subtitle">
        <%= required ? 'You must set a new password before continuing.' : 'Choose a new password for your account.' %>
      </p>
    </div>

    <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="alert alert-<%= notice.type === 'success' ? 'success' : 'danger' %>">
        <ion-icon name="alert-circle-outline"></ion-icon>
        <div class="alert-body"><%= notice.message %></div>
      </div>
    <% } %>

    <form method="POST" action="<%= adminPath %>/password/change" data-guard novalidate>
      <%- csrfField() %>

      <div class="form-row">
        <label class="form-label" for="current_password">Current password <span class="req">*</span></label>
        <div class="input-group">
          <input type="password" id="current_password" name="current_password"
                 class="form-input <%= formErrors.current_password ? 'has-error' : '' %>"
                 autocomplete="current-password" required autofocus>
          <button type="button" class="input-action" data-toggle-password="current_password" aria-label="Show password">
            <ion-icon name="eye-outline"></ion-icon>
          </button>
        </div>
        <% if (formErrors.current_password) { %>
          <p class="form-error"><ion-icon name="alert-circle-outline"></ion-icon><%= formErrors.current_password %></p>
        <% } %>
      </div>

      <div class="form-row">
        <label class="form-label" for="new_password">New password <span class="req">*</span></label>
        <div class="input-group">
          <input type="password" id="new_password" name="new_password"
                 class="form-input <%= formErrors.new_password ? 'has-error' : '' %>"
                 autocomplete="new-password" data-password-strength required>
          <button type="button" class="input-action" data-toggle-password="new_password" aria-label="Show password">
            <ion-icon name="eye-outline"></ion-icon>
          </button>
        </div>
        <div class="pw-strength" aria-hidden="true">
          <span class="pw-bar" data-pw-bar></span>
          <span class="pw-bar" data-pw-bar></span>
          <span class="pw-bar" data-pw-bar></span>
          <span class="pw-bar" data-pw-bar></span>
        </div>
        <p class="form-hint">At least 12 characters, including a letter and a number. Length matters more than symbols.</p>
        <% if (formErrors.new_password) { %>
          <p class="form-error"><ion-icon name="alert-circle-outline"></ion-icon><%= formErrors.new_password %></p>
        <% } %>
      </div>

      <div class="form-row">
        <label class="form-label" for="confirm_password">Confirm new password <span class="req">*</span></label>
        <input type="password" id="confirm_password" name="confirm_password"
               class="form-input <%= formErrors.confirm_password ? 'has-error' : '' %>"
               autocomplete="new-password" required>
        <% if (formErrors.confirm_password) { %>
          <p class="form-error"><ion-icon name="alert-circle-outline"></ion-icon><%= formErrors.confirm_password %></p>
        <% } %>
      </div>

      <button type="submit" class="btn btn-primary btn-block u-mt-24">
        <ion-icon name="save-outline"></ion-icon>
        <span>Update password</span>
      </button>
    </form>

    <% if (!required) { %>
      <p class="auth-footer"><a href="<%= adminPath %>/dashboard">Back to the dashboard</a></p>
    <% } %>
  </div>
</main>

<script src="/static/admin/js/admin.js" defer></script>
<script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>

</body>
</html>
