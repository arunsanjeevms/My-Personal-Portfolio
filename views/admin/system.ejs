<%- include('../partials/admin/head') %>

<div class="page-header">
  <div>
    <h1 class="page-title">System health</h1>
    <p class="page-subtitle">Runtime, database and storage status for this instance.</p>
  </div>
  <div class="page-header-actions">
    <span class="badge badge-<%= health.status === 'healthy' ? 'success' : health.status === 'warning' ? 'warning' : 'danger' %>">
      <span class="status-dot is-<%= health.status %>"></span><%= health.status %>
    </span>
    <a href="<%= adminPath %>/system" class="btn">
      <ion-icon name="refresh-outline"></ion-icon><span>Refresh</span>
    </a>
  </div>
</div>

<div class="grid grid-3">
  <% Object.entries(health.checks).forEach(function ([name, check]) { %>
    <div class="stat">
      <span class="stat-icon">
        <ion-icon name="<%= name === 'database' ? 'server-outline' : name === 'memory' ? 'hardware-chip-outline' : 'speedometer-outline' %>"></ion-icon>
      </span>
      <div style="min-width:0">
        <p class="stat-label" style="text-transform:capitalize"><%= name %></p>
        <p class="stat-value" style="font-size:var(--fs-4);margin-top:2px">
          <span class="status-dot is-<%= check.status %>"></span> <%= check.label %>
        </p>
        <% if (check.detail) { %><p class="stat-meta"><%= check.detail %></p><% } %>
      </div>
    </div>
  <% }); %>
</div>

<div class="grid grid-2 u-mt-24">

  <section class="card">
    <div class="card-header"><h2 class="card-title">Application</h2></div>
    <div class="detail-list">
      <div class="detail-row"><span class="detail-label">Version</span><span class="detail-value">v<%= health.application.version %></span></div>
      <div class="detail-row"><span class="detail-label">Environment</span><span class="detail-value"><%= health.application.environment %></span></div>
      <div class="detail-row"><span class="detail-label">Node.js</span><span class="detail-value u-mono"><%= health.application.nodeVersion %></span></div>
      <div class="detail-row"><span class="detail-label">Platform</span><span class="detail-value"><%= health.application.platform %></span></div>
      <div class="detail-row"><span class="detail-label">Process uptime</span><span class="detail-value"><%= h.formatDuration(health.application.uptimeSeconds) %></span></div>
      <div class="detail-row"><span class="detail-label">Server uptime</span><span class="detail-value"><%= h.formatDuration(health.application.systemUptimeSeconds) %></span></div>
      <div class="detail-row"><span class="detail-label">Started</span><span class="detail-value"><%= h.formatDateTime(health.application.startedAt) %></span></div>
      <div class="detail-row"><span class="detail-label">Process ID</span><span class="detail-value u-mono"><%= health.application.pid %></span></div>
      <div class="detail-row">
        <span class="detail-label">Git commit</span>
        <span class="detail-value u-mono"><%= health.application.gitCommit || 'not a git checkout' %></span>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><h2 class="card-title">Database</h2></div>
    <div class="detail-list">
      <div class="detail-row">
        <span class="detail-label">Status</span>
        <span class="detail-value">
          <span class="status-dot is-<%= health.checks.database.status %>"></span>
          <%= health.database.connected ? 'Connected' : 'Unreachable' %>
        </span>
      </div>
      <div class="detail-row"><span class="detail-label">Response time</span><span class="detail-value"><%= health.database.latencyMs === null ? '—' : health.database.latencyMs + ' ms' %></span></div>
      <div class="detail-row"><span class="detail-label">Tables</span><span class="detail-value"><%= health.database.tables %></span></div>
      <div class="detail-row"><span class="detail-label">Size on disk</span><span class="detail-value"><%= h.formatBytes(health.database.bytes) %></span></div>
      <%# Host, user and password are deliberately not shown here. %>
    </div>

    <div class="card-header u-mt-24" style="margin-bottom:14px"><h2 class="card-title">Cache</h2></div>
    <div class="detail-list">
      <div class="detail-row"><span class="detail-label">Cached keys</span><span class="detail-value"><%= health.cache.keys %></span></div>
      <div class="detail-row"><span class="detail-label">Hit rate</span><span class="detail-value"><%= health.cache.hitRate %>%</span></div>
      <div class="detail-row"><span class="detail-label">Hits / misses</span><span class="detail-value"><%= h.formatNumber(health.cache.hits) %> / <%= h.formatNumber(health.cache.misses) %></span></div>
    </div>
  </section>

</div>

<div class="grid grid-2 u-mt-24">

  <section class="card">
    <div class="card-header"><h2 class="card-title">Memory &amp; CPU</h2></div>

    <div class="form-row">
      <div class="u-flex u-justify-between u-small">
        <span class="u-muted">System memory</span>
        <span><%= h.formatBytes(health.memory.systemUsedBytes) %> / <%= h.formatBytes(health.memory.systemTotalBytes) %></span>
      </div>
      <div class="meter">
        <div class="meter-fill <%= health.memory.systemPercent > 92 ? 'is-critical' : health.memory.systemPercent > 80 ? 'is-warning' : '' %>"
             style="width: <%= health.memory.systemPercent %>%"></div>
      </div>
    </div>

    <div class="form-row">
      <div class="u-flex u-justify-between u-small">
        <span class="u-muted">Node heap</span>
        <span><%= h.formatBytes(health.memory.heapUsedBytes) %> / <%= h.formatBytes(health.memory.heapTotalBytes) %></span>
      </div>
      <div class="meter">
        <div class="meter-fill <%= health.memory.heapPercent > 90 ? 'is-warning' : '' %>"
             style="width: <%= health.memory.heapPercent %>%"></div>
      </div>
    </div>

    <div class="detail-list u-mt-16">
      <div class="detail-row"><span class="detail-label">Process RSS</span><span class="detail-value"><%= h.formatBytes(health.memory.processRssBytes) %></span></div>
      <div class="detail-row"><span class="detail-label">Process CPU</span><span class="detail-value"><%= health.cpu.processPercent %>%</span></div>
      <div class="detail-row"><span class="detail-label">CPU cores</span><span class="detail-value"><%= health.cpu.cores %></span></div>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><h2 class="card-title">Storage</h2></div>
    <div class="detail-list">
      <div class="detail-row"><span class="detail-label">Uploads</span><span class="detail-value"><%= h.formatBytes(health.storage.uploadBytes) %></span></div>
      <div class="detail-row"><span class="detail-label">Backups</span><span class="detail-value"><%= h.formatBytes(health.storage.backupBytes) %></span></div>
      <div class="detail-row"><span class="detail-label">Total</span><span class="detail-value"><%= h.formatBytes(health.storage.totalBytes) %></span></div>
    </div>

    <div class="alert alert-info u-mt-16 u-mb-0">
      <ion-icon name="information-circle-outline"></ion-icon>
      <div class="alert-body">
        Uploads live in <code>storage/uploads</code>, outside the web root, and are
        served through a controlled route that blocks execution.
      </div>
    </div>
  </section>

</div>

<%- include('../partials/admin/foot') %>
