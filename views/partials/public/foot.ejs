    </div>
  </main>

  <%# site.js is script.js with the fixes required for database-driven
      navigation. The original script.js is left in place, untouched, for
      the static fallback snapshot. %>
  <script src="/assets/js/site.js"></script>

  <%# Client-side analytics beacon. Only loaded when analytics is on and
      the visitor is not a signed-in admin. %>
  <% if (analyticsEnabled) { %>
    <script src="/assets/js/analytics.js" defer></script>
  <% } %>

  <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>

  <% if (customCode && customCode.body_end) { %><%- customCode.body_end %><% } %>

</body>

</html>
