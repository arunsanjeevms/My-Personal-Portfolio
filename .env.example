#######################################################################
# Portfolio CMS - environment template
#
#   cp .env.example .env      (or: copy .env.example .env  on Windows)
#   npm run setup             fills in the rest interactively
#
# NEVER commit the real .env file. It is git-ignored on purpose.
#######################################################################

# ---------------------------------------------------------------- app
NODE_ENV=development
PORT=3000

# Public base URL, no trailing slash. Used for canonical URLs,
# sitemap.xml, Open Graph tags and absolute links in emails.
SITE_URL=http://localhost:3000

# Set to 1 only when running behind Nginx / a load balancer so that
# Express reads the real client IP from X-Forwarded-For.
TRUST_PROXY=0

# --------------------------------------------------------- database
# XAMPP default: host 127.0.0.1, port 3306, user root, empty password.
# XAMPP ships MariaDB (10.4.x) - the schema is written to be compatible.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_cms
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# --------------------------------------------------------- sessions
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to boot in production if this is missing or default.
SESSION_SECRET=
SESSION_NAME=pcms.sid
# Idle timeout (minutes) and absolute lifetime (hours)
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=168

# ------------------------------------------------------------ crypto
# 64 hex chars (32 bytes). Encrypts TOTP secrets at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Rotated daily and mixed into visitor hashes so analytics cannot be
# used to re-identify a person or link them across days.
ANALYTICS_SALT=

# ------------------------------------------------------------ admin
# Path prefix for the admin area. Changing this is obscurity, NOT
# security - real protection is the auth + RBAC middleware.
ADMIN_PATH=/admin

# ---------------------------------------------------------- storage
UPLOAD_DIR=storage/uploads
BACKUP_DIR=storage/backups
MAX_UPLOAD_MB=20

# ------------------------------------------------------------- mail
# Optional. SMTP can also be configured from /admin/settings, which
# takes priority over these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Arun Sanjeev
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=

# ---------------------------------------------------------- logging
# error | warn | info | debug
LOG_LEVEL=info
LOG_DIR=logs

# --------------------------------------------------- mysql binaries
# Only needed for /admin/backups. XAMPP paths shown.
MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
MYSQL_CLIENT_PATH=C:/xampp/mysql/bin/mysql.exe
